rules_version = '2';
// Regras de Segurança do Firestore do FiscoCont+ (projeto fiscocontmais) — versão 2.1.4.
// Publicadas automaticamente pelo GitHub (workflow "Publicar funções e regras no Firebase").
// Publicar em: Console do Firebase > Firestore Database > Regras > colar este arquivo inteiro > Publicar.
//
// • Login individual (e-mail e senha): o perfil fica em usuarios/{uid}; só Admin ativo cadastra, bloqueia e muda perfil.
// • Licença por máquina continua com login anônimo: a máquina lê o próprio status e cria o registro como "pendente".
// • Dados (balancetes, histórico) e a chave da IA: só para usuário logado e ativo (antes bastava o login anônimo).
// • Ninguém usa mais a credencial de administrador (conta de serviço) nas máquinas.
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider == 'password';
    }
    function emailDoToken() {
      return request.auth.token.email.lower();
    }
    function cadastro() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }
    function ativo() {
      return logado() && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) && cadastro().ativo == true;
    }
    function admin() {
      return ativo() && cadastro().perfil == 'admin';
    }
    function perfilValido(p) {
      return p in ['fiscal', 'contabil', 'admin'];
    }

    // ------------------------------------------------------------ usuários
    match /usuarios/{uid} {
      allow read: if (logado() && request.auth.uid == uid) || admin();
      allow delete: if admin() && resource.data.email != 'rafael.max17@gmail.com';
      allow update: if (admin()
          // Admin principal do sistema: perfil, situação e módulos não mudam (nem por outro Admin)
          && (resource.data.email != 'rafael.max17@gmail.com'
              || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['perfil', 'ativo', 'modulos', 'email'])))
        // a própria pessoa só consegue marcar que já criou a senha dela (depois da senha provisória)
        || (logado() && request.auth.uid == uid && resource.data.ativo == true
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['trocarSenha', 'senhaTrocadaEm'])
            && request.resource.data.trocarSenha == false);
      allow create: if admin()
        // 1º acesso de quem foi convidado pelo Admin: copia exatamente o convite
        || (logado() && request.auth.uid == uid
            && request.resource.data.email == emailDoToken()
            && exists(/databases/$(database)/documents/convites/$(emailDoToken()))
            && request.resource.data.perfil == get(/databases/$(database)/documents/convites/$(emailDoToken())).data.perfil
            && request.resource.data.ativo == true)
        // 1º Admin do sistema (uma vez, com o e-mail confirmado)
        || (logado() && request.auth.uid == uid
            && emailDoToken() == 'rafael.max17@gmail.com'
            && request.auth.token.email_verified == true
            && request.resource.data.perfil == 'admin'
            && request.resource.data.ativo == true);
    }

    match /convites/{email} {
      allow read: if admin() || (logado() && emailDoToken() == email);
      allow create, update: if admin() && perfilValido(request.resource.data.perfil);
      allow delete: if admin();
    }

    // ------------------------------------------------------------ licença por máquina
    match /licencas/{codigo} {
      allow get: if request.auth != null;
      allow list: if admin();
      allow create: if request.auth != null && request.resource.data.status == 'pendente';
      allow update: if admin()
        || (request.auth != null
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ultimoAcesso', 'versao', 'hwid', 'usuario']));
      allow delete: if admin();
    }

    // ------------------------------------------------------------ configuração (chave da IA)
    // Só a função chatIA (servidor do Google) lê a chave; nenhum computador consegue mais.
    match /config/{doc} {
      allow read, write: if false;    // gravar só pelo Console do Firebase
    }

    // ------------------------------------------------------------ balancetes e histórico
    match /empresas/{cnpj} {
      allow read, write: if ativo();
      match /historico/{id} {
        allow read, write: if ativo();
      }
    }

    // ------------------------------------------------------------ Simples Nacional · fechamento da equipe
    // cadastro (empresas e analistas): só o Admin grava; competências (AAAA-MM): toda a equipe ativa marca as etapas.
    match /fechamento_sn/{doc} {
      allow read: if ativo();
      allow write: if (doc == 'cadastro' && admin())
        || (doc != 'cadastro' && ativo() && doc.matches('^[0-9]{4}-(0[1-9]|1[0-2])$'));
    }

    // qualquer outra coleção: fechada
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
